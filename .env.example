# Copie ce fichier en .env.local et remplis les valeurs (Supabase > Project Settings > API Keys).
# Ces deux clés sont publiques. Ne mets jamais ici la clé secrète (secret / service_role).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
